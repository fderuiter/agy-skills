{
  "git-safety": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/block-dangerous-git.js"
          }
        ]
      }
    ]
  },
  "prose-invariants": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/check-prose-invariants.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node hooks/check-prose-invariants.js"
      }
    ]
  }
}

