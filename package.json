{
  "name": "agy-skills",
  "version": "1.3.0",
  "private": true,
  "description": "Fred de Ruiter's agent skills for Antigravity (AGY)",
  "repository": {
    "type": "git",
    "url": "https://github.com/fderuiter/agy-skills"
  },
  "license": "MIT",
  "scripts": {
    "link": "node scripts/link-skills.mjs",
    "new-skill": "node scripts/new-skill.mjs",
    "list": "node scripts/list-skills.mjs",
    "check-seo": "node scripts/check-seo.mjs",
    "check-skills": "node scripts/check-skills.mjs",
    "check-links": "node scripts/check-links.mjs",
    "check-terminology": "node scripts/check-terminology.mjs",
    "check-paths": "node scripts/check-hardcoded-paths.mjs",
    "test:sdk": "python tests/test_sdk_benchmarks.py",
    "test": "node scripts/check-seo.mjs && node scripts/check-skills.mjs && node scripts/check-links.mjs && node scripts/check-terminology.mjs && node scripts/check-hardcoded-paths.mjs",
    "test:all": "npm test && npm run test:sdk",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "wizard": "node scripts/wizard.mjs",
    "setup-mcp-env": "node scripts/setup-antigravity-mcp.mjs",
    "setup-hooks": "node scripts/setup-git-hooks.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "sync-wiki": "node scripts/sync-wiki.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "packageManager": "npm@10.9.4"
}
